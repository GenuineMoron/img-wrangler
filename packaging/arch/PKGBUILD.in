# Arch Linux package for Wrangler (CachyOS, EndeavourOS, Manjaro…), built from the release's
# .deb and command line archive, so it uses the system's own WebKitGTK.
#   makepkg -si
# The release workflow fills in @VERSION@ and the checksums.

pkgname=img-wrangler-bin
_ver=@VERSION@
pkgver=${_ver//-/_}
pkgrel=1
pkgdesc='Batch image processing: resize, square up, compress, convert, rename and watermark'
arch=('x86_64' 'aarch64')
url='https://github.com/GenuineMoron/img-wrangler'
license=('AGPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme' 'libayatana-appindicator')
optdepends=('libheif: open HEIC photos from iPhones')
provides=('img-wrangler')
conflicts=('img-wrangler')
_rel="$url/releases/download/v$_ver"
source_x86_64=("$_rel/Wrangler_${_ver}_amd64.deb" "$_rel/img-wrangler-v$_ver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$_rel/Wrangler_${_ver}_arm64.deb" "$_rel/img-wrangler-v$_ver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@SHA_DEB_X86_64@' '@SHA_CLI_X86_64@')
sha256sums_aarch64=('@SHA_DEB_AARCH64@' '@SHA_CLI_AARCH64@')
noextract=()

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  install -Dm755 "img-wrangler-v$_ver-$CARCH-unknown-linux-gnu/img-wrangler" "$pkgdir/usr/bin/img-wrangler"
  install -Dm644 "img-wrangler-v$_ver-$CARCH-unknown-linux-gnu/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
