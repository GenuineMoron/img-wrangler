<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's Info.plist by the bundler. img-wrangler://finder is how the Finder
     extension wakes the app. The address carries nothing: see finder/FinderSync.swift. -->
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.genuinemoron.wrangler</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>img-wrangler</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
