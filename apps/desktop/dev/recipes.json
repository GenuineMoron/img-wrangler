          "mode": "subfolder",
          "on_conflict": "number",
          "suffix": "-web"
        },
        "format": {
          "auto": false,
          "id": "webp",
          "matte": "#ffffff"
        },
        "metadata": {
          "keep": "none"
        },
        "name": "Compress for web",
        "quality": {
          "allow_downscale": false,
          "look": "balanced",
          "max_kb": null,
          "never_bigger": true,
          "progressive": true
        },
        "rename": {
          "case": "keep",
          "list": "",
          "mode": "keep",
          "pattern": "{name}",
          "replace": [],
          "start": 1,
          "step": 1
        },
        "select": {
          "exclude": [],
          "include": [],
          "min_kb": null,
          "recursive": false
        },
        "size": {
          "anchor": "center",
          "edge": "long",
          "filter": "lanczos3",
          "fit": "pad",
          "long_side": 2560,
          "pad": {
            "backdrop": "auto",
            "fill": 100.0
          },
          "shape": "original",
          "trim": null,
          "upscale": false
        },
        "version": 1
      }
